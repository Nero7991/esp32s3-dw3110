# DW3000 SPI Configuration
CONFIG_DW3000_SPI_CLK=40 #12
CONFIG_DW3000_SPI_MOSI=41 #11
CONFIG_DW3000_SPI_MISO=39 #13
CONFIG_DW3000_SPI_CS=42 #10 
CONFIG_DW3000_SPI_MAX_MHZ=22

# DW3000 Control Pins
CONFIG_DW3000_GPIO_IRQ=5
CONFIG_DW3000_GPIO_RESET=6
CONFIG_DW3000_GPIO_WAKEUP=4

# DW3000 Chip Selection
CONFIG_DW3000_CHIP_DW3000=y

# TWR Mode - controlled via build command:
#   make initiator / make responder
#   or: idf.py -DTWR_MODE=initiator/responder build
# CONFIG_TWR_INITIATOR is not set

# Debug Settings (disabled for TWR timing)
# CONFIG_DW3000_SPI_TRACE is not set (causes crash when called from ISR)
# CONFIG_DECA_DEBUG_RX_STATUS is not set
# CONFIG_DECA_DEBUG_RX_DUMP is not set
# CONFIG_DECA_DEBUG_TX_DUMP is not set
